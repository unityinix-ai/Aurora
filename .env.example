# Copy to .env on the staging host. Never commit the real .env file.
DOMAIN=aurora.example.com
ACME_EMAIL=ops@example.com

# OIDC provider: use the issuer, audience and JWKS URL from its official docs.
JWT_JWKS_URL=https://identity.example.com/.well-known/jwks.json
JWT_ISSUER=https://identity.example.com/
JWT_AUDIENCE=aurora-api
JWT_CLOCK_SKEW_SECONDS=30

# Optional until model-provider credentials and model are selected.
MODEL_API_KEY=
MODEL_NAME=
MODEL_API_BASE_URL=https://api.openai.com/v1
MODEL_TIMEOUT_SECONDS=30

# Include the exact HTTPS origin(s) of any separately hosted frontend.
CORS_ORIGINS=https://aurora.example.com
